# YouTube Karaoke Together - Client Environment Variables
# These are only needed for local development

# Enable development mode (connects to explicit backend URL instead of /ws/)
VITE_DEV=true

# Backend URL for development (not needed in production - uses same origin)
VITE_BACKEND_URL=http://localhost:8080

# Google OAuth web client ID used by the lazy-loaded administrator login.
# This must match GOOGLE_CLIENT_ID on the server.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
