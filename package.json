{
  "name": "youtube-karaoke-together",
  "version": "3.2.0",
  "description": "A collaborative YouTube video queuing system",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "test": "node --test test/**/*.test.js",
    "test:client": "npm --prefix client test",
    "test:all": "npm test && npm run test:client",
    "check:syntax": "for file in server.js ecosystem.config.js src/server/*.js scripts/*.js; do node --check \"$file\"; done",
    "check": "npm run check:syntax && node --test test/**/*.test.js && npm --prefix client run test:run && npm --prefix client run build",
    "admin:bootstrap": "node scripts/admin-bootstrap.js",
    "admin:recover": "node scripts/admin-recover.js",
    "db:backup": "node scripts/db-backup.js",
    "db:integrity": "node scripts/db-integrity.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3"
  },
  "license": "GPL-3.0-only"
}
