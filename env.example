# YouTube Karaoke Together - Server Environment Variables

# Server Configuration
PORT=8080

# Environment selection
# For development:
NODE_ENV=development
# For production:
# NODE_ENV=production

# Public-facing frontend origin (used for QR code generation and CORS)
# In production, set this to your actual frontend URL (e.g., https://kae.zhg.au)
PUBLIC_FRONTEND_ORIGIN=http://localhost:3000

# Optional comma-separated exact additional origins (scheme, host, and port).
# ALLOWED_ORIGINS=https://staging.example.com

# Optional limits config path (defaults to ./server-limits.json)
# LIMITS_CONFIG_PATH=/path/to/server-limits.json

# SQLite database and backup locations
# DATABASE_PATH=./data/youtube-karaoke.sqlite
# BACKUP_DIR=./backups
# AUTO_BACKUPS=true
# Application-managed backups rotate within 24 hours to avoid extending the
# YouTube API-data retention window. Do not extend without a compliance review.

# Room lifecycle (hours of authenticated inactivity)
# ROOM_INACTIVITY_HOURS=24

# Secret pepper used when hashing room/admin bearer tokens. Set a long random
# value in production and preserve it across restarts.
TOKEN_PEPPER=replace_with_a_long_random_secret

# YouTube Data API Key - Get from https://console.developers.google.com/
# 1. Create a project in Google Cloud Console
# 2. Enable YouTube Data API v3
# 3. Create credentials (API key)
# 4. Paste the API key here
YOUTUBE_API_KEY=your_youtube_api_key_here
# YOUTUBE_API_KEY_ALIAS=production

# Google Identity Services OAuth client ID for administrator sign-in.
# Keep admin sign-in separate from YouTube API authorization scopes.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
